{
  "name": "medical-chatbot",
  "version": "1.0.0",
  "description": "AI-powered bilingual medicine information chatbot built with Node.js, Express, SQLite and Google Gemini.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ozzy404/medical-chatbot.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
